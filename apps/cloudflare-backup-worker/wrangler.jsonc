{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linked-info-backup-api",
  "main": "build/index.js",
  "compatibility_date": "2026-08-12",
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "linked-info-backups",
      "preview_bucket_name": "linked-info-backups-preview"
    }
  ],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "cargo install -q \"worker-build@^0.8\" && worker-build --release"
  }
}
