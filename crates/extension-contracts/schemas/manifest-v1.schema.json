{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linked-info.invalid/schemas/extension-manifest-v1.schema.json",
  "title": "Linked Info extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "apiVersion",
    "publisher",
    "defaultLocale",
    "locales",
    "entrypoint",
    "metadataSchema",
    "metadataSchemaVersion",
    "capabilities",
    "contributions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?){2,}$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "maxLength": 64
    },
    "apiVersion": { "const": "1.0" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?=.*\\S).+$",
          "minLength": 1,
          "maxLength": 128
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "minLength": 2,
      "maxLength": 35
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
        "minLength": 2,
        "maxLength": 35
      }
    },
    "entrypoint": { "const": "extension.wasm" },
    "metadataSchema": { "const": "metadata.schema.json" },
    "metadataSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "capabilities": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "node.read.name",
          "node.read.content",
          "graph.read.direct",
          "metadata.node.read",
          "metadata.node.write",
          "metadata.workspace.read",
          "metadata.workspace.write",
          "workspace.propose",
          "clock.monotonic"
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processors", "actions"],
      "anyOf": [
        { "properties": { "processors": { "minItems": 1 } } },
        { "properties": { "actions": { "minItems": 1 } } }
      ],
      "properties": {
        "processors": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/processor" }
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    }
  },
  "$defs": {
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "labelKey"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$",
          "maxLength": 192
        },
        "labelKey": {
          "type": "string",
          "pattern": "^[a-z](?:[A-Za-z0-9_-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?)*$",
          "maxLength": 128
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "labelKey", "scope"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$",
          "maxLength": 192
        },
        "labelKey": {
          "type": "string",
          "pattern": "^[a-z](?:[A-Za-z0-9_-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?)*$",
          "maxLength": 128
        },
        "scope": { "enum": ["current-node", "selection"] }
      }
    }
  }
}
